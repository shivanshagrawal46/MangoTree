# Copy to .env and fill. .env is git-ignored and must never be committed.

# --- MongoDB Atlas ---
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_CLUSTER=cluster1.skzgbj.mongodb.net
MONGO_DB=samtacode46_db

# --- AI providers ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# OpenAI: two keys so the spend shows separately in the OpenAI console.
OPENAI_API_KEY=            # OCR fallback tier (GPT-5 vision) — existing key
OPENAI_API_KEY_CRITIC=     # GPT-5.6 second reader on every answer — new key; falls back to OPENAI_API_KEY if blank

# --- Gmail (read-only) ---
GMAIL_CLIENT_SECRET=client_secret.json
GMAIL_TOKEN_PATH=gmail_token.json

# --- Ingestion policy ---
# Backfill lower bound (inclusive). Nothing before this date is ingested.
BACKFILL_SINCE=2023-10-01
# strict = only allow-listed external counterparties (see config/registry.py)
PARTICIPANT_POLICY=strict

# --- Local raw store (byte-for-byte originals; S3 later) ---
RAW_STORE=raw_store

# --- Disk corpus ---
DISK_CORPUS_ROOT=E:\LP Remodeling Projects\Hold Properties

# --- ARV / underwriting (2026-10-14) — every key optional ---
# RentCast: MLS-derived property records, sale comparables and an AVM to blend.
# Free developer tier is 50 calls/month (https://www.rentcast.io/api). Without it
# the system uses Census geocoding, Claude web search and manual comps.
RENTCAST_API_KEY=
# ARV_MODEL=claude-opus-5-5      # analyst seat (default); ARV_EFFORT=high
# ARV_COMP_RADIUS_MILES=1.0  ARV_COMP_MONTHS=12  ARV_COMP_TARGET=6
# ARV documents (inspection reports, bids, photos) are stored in the object store (RAW_STORE / Spaces) under their sha256 and read once by ARV_MODEL.

REALESTATEAPI_KEY=
HOUSECANARY_API_KEY=
HOUSECANARY_API_SECRET=
